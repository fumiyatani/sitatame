<idea-plugin>
    <id>dev.sitatame.intellij</id>
    <name>sitatame review</name>
    <vendor email="fumisorena@gmail.com" url="https://github.com/fumiyatani/sitatame">fumiyatani</vendor>

    <description><![CDATA[
        Author and consume sitatame code reviews directly inside IntelliJ
        Community / IDEA Ultimate / Android Studio.<br/>
        <br/>
        This release covers the write path: select a range, add a comment,
        list everything in a tool window, and copy an AI-ready prompt to the
        clipboard. Reviews are stored under
        <code>~/.sitatame/&lt;project-slug&gt;/&lt;branch-slug&gt;/review.md</code>
        so the CLI, Web UI and IntelliJ plugin all see the same file.<br/>
        <br/>
        Status: experimental. Not yet on JetBrains Marketplace; install from
        disk via <code>./gradlew buildPlugin</code>.
    ]]></description>

    <change-notes><![CDATA[
        <b>0.2.0</b> — new 1-branch-1-file layout (#76). Single review.md per
        branch with automatic .bak backup. PromoteReview action removed.<br/>
        <b>0.1.0</b> — initial scaffold. Range / line comment actions,
        tool window listing, AI prompt copy, SITATAME_HOME override in Settings.
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="SitatameReview"
            anchor="right"
            icon="AllIcons.Toolwindows.ToolWindowMessages"
            factoryClass="dev.sitatame.intellij.toolwindow.SitatameToolWindowFactory"/>

        <applicationConfigurable
            parentId="tools"
            id="dev.sitatame.intellij.settings.SitatameConfigurable"
            displayName="sitatame review"
            instance="dev.sitatame.intellij.settings.SitatameConfigurable"/>

        <!--
            ReviewStore and SitatameSettings are registered via @Service
            annotations on the classes themselves. Listing them here too
            would double-register and trigger a startup warning.
        -->

        <notificationGroup id="sitatame.review" displayType="BALLOON"/>

        <!--
            SitatameEditorFactoryListener hooks editorCreated to attach block
            inlays for sitatame comments. Registered here (not via @Listener
            annotation) so it is explicit and version-controllable.
        -->
        <editorFactoryListener
            implementation="dev.sitatame.intellij.inlay.SitatameEditorFactoryListener"/>

        <!--
            Gutter line markers: draws an icon in the editor gutter for every
            line that carries a sitatame review comment.
            language="any" makes IntelliJ call the provider for all file types.
        -->
        <codeInsight.lineMarkerProvider
            language="any"
            implementationClass="dev.sitatame.intellij.markers.SitatameLineMarkerProvider"/>

        <!--
            Project startup activity: connects to ReviewChangedTopic and
            restarts DaemonCodeAnalyzer when the review store is mutated so
            gutter markers refresh without a manual file-open/close cycle.
        -->
        <postStartupActivity
            implementation="dev.sitatame.intellij.markers.SitatameProjectActivity"/>

        <!--
            Storage startup activity: calls ReviewStore.recoverFromCrash once
            per project open to promote orphaned review.md.bak files and clean
            up leftover .tmp files from interrupted write cycles (issue #106).
        -->
        <postStartupActivity
            implementation="dev.sitatame.intellij.storage.ReviewStoreStartupActivity"/>
    </extensions>

    <actions>
        <!--
            Add Comment is the entry point for the write path. Cmd+Shift+C
            mirrors the CLI's `sitatame comment` shortcut convention and
            doesn't collide with the standard IDEA copy/comment shortcuts.
        -->
        <action id="sitatame.AddComment"
                class="dev.sitatame.intellij.actions.AddCommentAction"
                text="sitatame: Add Comment"
                description="Add a sitatame review comment for the current selection or line">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift C"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift C" replace-all="false"/>
        </action>

        <!--
            File-level comment. Mirrors the Go TUI's `c` on a file header:
            the comment is scoped to the whole file (FILE anchor), not a line.
            No default shortcut to avoid collisions; reachable from the editor
            popup menu and Keymap.
        -->
        <action id="sitatame.AddFileComment"
                class="dev.sitatame.intellij.actions.AddFileCommentAction"
                text="sitatame: Add File Comment"
                description="Add a sitatame review comment scoped to the whole current file">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <!--
            Review-level comment. Mirrors the Go TUI's `Shift+R`: a remark about
            the whole change (REVIEW anchor), not tied to any file or line.
        -->
        <action id="sitatame.AddReviewComment"
                class="dev.sitatame.intellij.actions.AddReviewCommentAction"
                text="sitatame: Add Review Comment"
                description="Add a sitatame review-level comment about the whole change"/>

        <action id="sitatame.ResolveComment"
                class="dev.sitatame.intellij.actions.ResolveCommentAction"
                text="sitatame: Toggle Resolved"
                description="Toggle the resolved/open state of a sitatame comment under the caret">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift R"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift R" replace-all="false"/>
        </action>

        <!--
            In-editor comment traversal. Mirrors the Go TUI's keyboard-driven
            stepping through commented lines so a reviewer can stay in the editor
            instead of round-tripping through the tool window.
        -->
        <action id="sitatame.GoToNextComment"
                class="dev.sitatame.intellij.actions.GoToNextCommentAction"
                text="sitatame: Go to Next Comment"
                description="Move the caret to the next sitatame-commented line in this file">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift PERIOD"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift PERIOD" replace-all="false"/>
        </action>

        <action id="sitatame.GoToPrevComment"
                class="dev.sitatame.intellij.actions.GoToPrevCommentAction"
                text="sitatame: Go to Previous Comment"
                description="Move the caret to the previous sitatame-commented line in this file">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="meta shift COMMA"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift COMMA" replace-all="false"/>
        </action>

        <action id="sitatame.CopyAIPrompt"
                class="dev.sitatame.intellij.actions.CopyAIPromptAction"
                text="sitatame: Copy AI Prompt"
                description="Copy an AI-ready prompt for the selected or all open comments"/>

        <!--
            Tool-window resolve toggle.

            No default shortcut: Space is hard-wired in SitatameToolWindowContent's
            KeyListener so it works out of the box without any Keymap entry.

            This Action exists so users can bind an additional shortcut
            (e.g. Ctrl+Shift+R) without losing the Space behaviour. Bound shortcuts
            are consumed by IdeKeyEventDispatcher before reaching the Swing
            KeyListener, so there is no double-fire.

            Bind via Settings → Keymap → "sitatame: Toggle Resolved (Tool Window)".
        -->
        <action id="sitatame.ToolWindowToggleResolved"
                class="dev.sitatame.intellij.actions.ToolWindowToggleResolvedAction"
                text="sitatame: Toggle Resolved (Tool Window)"
                description="Toggle the resolved/open state of the comment selected in the Sitatame tool window"/>
    </actions>
</idea-plugin>
